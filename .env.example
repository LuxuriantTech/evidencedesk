# Valeurs de développement local uniquement. Ne pas réutiliser en production.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://evidencedesk:evidencedesk@postgres:5432/evidencedesk
REDIS_URL=redis://redis:6379/0
STORAGE_ROOT=/data/documents
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=30
PUBLIC_DEMO_MODE=true
PUBLIC_DEMO_ALLOWLIST=datasets/public_demo_uploads.json
MAX_UPLOAD_BYTES=10485760
MAX_REQUEST_BYTES=11534336
MAX_DOCUMENT_PAGES=200
MAX_EXTRACTED_CHARS=1000000
MAX_DOCUMENT_CHUNKS=5000
PDF_PARSE_TIMEOUT_SECONDS=10
PDF_PARSE_MEMORY_BYTES=536870912
ANSWER_MODE=extractive-local-onnx
EMBEDDING_MODEL_PATH=models/paraphrase-multilingual-minilm-l12-v2
EMBEDDING_MANIFEST_PATH=infra/models/paraphrase-multilingual-minilm-l12-v2.json
DEMO_ADMIN_PASSWORD=EvidenceDemo-Admin-2026!
DEMO_ANALYST_PASSWORD=EvidenceDemo-Analyst-2026!
DEMO_READER_PASSWORD=EvidenceDemo-Reader-2026!
